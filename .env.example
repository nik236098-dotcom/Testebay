# Токен API Lolzteam: https://lolz.live/account/api  (нужна область "market")
LZT_TOKEN=

# Токен бота от @BotFather
TG_BOT_TOKEN=

# Куда слать уведомления. Узнать: python get_chat_id.py
TG_CHAT_ID=

# Категория и фильтры из ссылки https://lzt.market/telegram/?country[]=UZ&min_contacts=100&spam=no
LZT_CATEGORY=telegram
LZT_QUERY=country[]=UZ&min_contacts=100&spam=no

# Период опроса, секунд
POLL_INTERVAL=60

# 1 - при первом запуске прислать все текущие лоты, 0 - только новые
NOTIFY_ON_FIRST_RUN=0

STATE_FILE=state.json
