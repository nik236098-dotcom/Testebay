# ---------- Telegram ----------
# Токен бота от @BotFather
TG_BOT_TOKEN=
# Ваш Telegram ID (число). Если задан, бот отвечает только вам, остальным - отказ.
# Узнать: напишите боту /id (или спросите @userinfobot). Можно несколько через запятую.
TG_USER_ID=
# Необязательно: чат, который подписан сразу без /start (например, id группы)
TG_CHAT_ID=

# ---------- Откуда брать лоты ----------
# web - читать страницу сайта (бесплатно, по умолчанию)
# api - официальный API (платный доступ, нужен LZT_TOKEN)
SOURCE=web

# (web) Если сайт отдаёт проверку DDoS-Guard/блокирует запросы: скопируйте из
# браузера значение заголовка Cookie для lzt.market (DevTools -> Network -> любой
# запрос -> Request Headers -> Cookie) и вставьте целиком.
LZT_COOKIES=
# (web) 1 - грузить страницу через настоящий Chromium (Playwright), если
# обычные запросы не проходят. Требует: pip install playwright && playwright install chromium
USE_BROWSER=0

# (api) Токен API Lolzteam: https://lolz.live/account/api
LZT_TOKEN=

# ---------- Второй сайт: tronaccs.market (необязательно) ----------
# Токен API: на tronaccs.market нажмите на свой ник/аватар -> "API TronAccs" -> создать токен.
# Если токен задан, мониторинг tronaccs включён. Управлять из бота: /tron on|off
TRON_TOKEN=
# Фильтр на стороне бота (у API tronaccs фильтров нет). Названия полей: /trondump
# Пример: country=UZ contacts>=100 spam=no price<=500
TRON_FILTER=
# Сколько страниц списка просматривать за одну проверку
TRON_PAGES=5

# ---------- Фильтры ----------
# Из ссылки https://lzt.market/telegram/?country[]=UZ&min_contacts=100&spam=no
LZT_CATEGORY=telegram
LZT_QUERY=country[]=UZ&min_contacts=100&spam=no

# Период опроса, секунд
POLL_INTERVAL=60

# 1 - при первом запуске прислать все текущие лоты, 0 - только новые
NOTIFY_ON_FIRST_RUN=0
# 1 - при каждом запуске монитора писать подписчикам "монитор запущен"
NOTIFY_ON_STARTUP=1
# 1 - перед покупкой по кнопке спрашивать подтверждение, 0 - покупать сразу
BUY_CONFIRM=0

STATE_FILE=state.json
