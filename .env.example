# ---------- Telegram ----------
# Токен бота от @BotFather
TG_BOT_TOKEN=
# Telegram ID владельца (число, узнать: написать боту /id). Можно несколько через запятую.
# Владелец создаёт коды доступа для других: /invite <код>
TG_USER_ID=
# Необязательно: чат владельца, который подписан сразу (например, id группы)
TG_CHAT_ID=

# ---------- Токены владельца (другие пользователи вводят свои прямо в боте) ----------
# lzt.market: https://lolz.live/account/api, область "market"
LZT_TOKEN=
# tronaccs.market: на сайте нажмите на ник -> "API TronAccs" -> создать токен
TRON_TOKEN=

# ---------- Фильтры по умолчанию (меняются в боте через /settings) ----------
LZT_CATEGORY=telegram
LZT_QUERY=country[]=UZ&min_contacts=100&spam=no
TRON_FILTER=country=UZ contacts>=100 spam=no
# Сколько страниц списка tronaccs (новые первыми) просматривать за проверку
TRON_PAGES=2

# ---------- Общее ----------
# Период опроса, секунд
POLL_INTERVAL=60
# 1 - при первом запуске прислать все текущие лоты, 0 - только новые
NOTIFY_ON_FIRST_RUN=0
# 1 - при каждом запуске монитора писать подписчикам "монитор запущен"
NOTIFY_ON_STARTUP=1
# 1 - перед покупкой по кнопке спрашивать подтверждение, 0 - покупать сразу
BUY_CONFIRM=0
STATE_FILE=state.json

# ---------- lzt без API (SOURCE=web), только для владельца ----------
# web - читать страницу сайта вместо API; cookies из браузера, если сайт блокирует
SOURCE=api
LZT_COOKIES=
USE_BROWSER=0
